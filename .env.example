# demo runs the real nanobot loop with a deterministic local model adapter.
PM_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PM_DAILY_BUDGET_USD=1
# Peak price per million tokens; update when switching models.
PM_INPUT_PRICE=0.30
PM_OUTPUT_PRICE=1.20
PM_TIMEZONE=America/Los_Angeles
PM_PORT=8787
